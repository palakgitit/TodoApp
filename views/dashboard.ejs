<!DOCTYPE html>
<html>

<head>

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <div class="container mt-5">

        <h1 class="mb-4">
            Todo Dashboard
        </h1>


        <a href="/add-task" class="btn btn-dark mb-4">

            Add New Task

        </a>


        <div class="table-responsive">

            <table class="table table-bordered table-striped table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>Task ID</th>

                        <th>Title</th>

                        <th>Description</th>

                        <th>Priority</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    <% tasks.forEach(task=> { %>

                        <tr>

                            <td>
                                <%= task.id %>
                            </td>


                            <td>
                                <%= task.title %>
                            </td>


                            <td>
                                <%= task.description %>
                            </td>


                            <td>
                                <%= task.priority %>
                            </td>


                            <td>

                                <% if(task.status==='Pending' ) { %>

                                    <span class="badge bg-warning">

                                        Pending

                                    </span>

                                    <% } %>


                                        <% if(task.status==='In Progress' ) { %>

                                            <span class="badge bg-primary">

                                                In Progress

                                            </span>

                                            <% } %>


                                                <% if(task.status==='Completed' ) { %>

                                                    <span class="badge bg-success">

                                                        Completed

                                                    </span>

                                                    <% } %>

                            </td>


                            <td>

                                <a href="/edit-task/<%= task.id %>" class="btn btn-primary btn-sm">
                                    Edit
                                </a>


                                <a href="/delete-task/<%= task.id %>" class="btn btn-danger btn-sm">
                                    Delete
                                </a>


                                <a href="/status-task/<%= task.id %>" class="btn btn-warning btn-sm">
                                    Change Status
                                </a>

                            </td>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</body>

</html>